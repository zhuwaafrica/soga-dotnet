<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared package settings (authors, license, icon, readme, Source Link, version) are in src/Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>Soga</PackageId>
    <Description>Self-hosted messaging framework for ASP.NET Core: direct and group conversations, persistent messages, roles, authorization, history, read state, realtime SignalR events and recovery after a disconnect.</Description>
    <PackageTags>messaging;chat;conversations;signalr;realtime;aspnetcore;self-hosted;direct-messages;group-chat</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Soga.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Soga.Tests" />
    <InternalsVisibleTo Include="Soga.IntegrationTests" />
    <InternalsVisibleTo Include="Soga.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
