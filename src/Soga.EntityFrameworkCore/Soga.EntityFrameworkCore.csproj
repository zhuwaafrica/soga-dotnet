<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared package settings (authors, license, icon, readme, Source Link, version) are in src/Directory.Build.props. -->
  <PropertyGroup>
    <PackageId>Soga.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core storage for Soga: SQL Server and PostgreSQL in production, SQLite for development. Your DbContext owns the schema and migrations.</Description>
    <PackageTags>messaging;chat;signalr;aspnetcore;entityframeworkcore;efcore;sqlserver;postgresql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <ProjectReference Include="..\Soga\Soga.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Soga.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
